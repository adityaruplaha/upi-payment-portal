{
	"name": "upi-payment-portal",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "rm -rf .svelte-kit/cloudflare && wrangler types --check && vite build",
		"preview": "wrangler dev",
		"deploy": "bun run build && wrangler deploy",
		"db:admin": "bun scripts/admin.ts",
		"test": "bun test",
		"prepare": "svelte-kit sync || echo ''",
		"check": "rm -rf .svelte-kit/cloudflare && wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"gen": "rm -rf .svelte-kit/cloudflare && wrangler types",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@clack/prompts": "^1.8.1",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^9.39.5",
		"@sveltejs/adapter-cloudflare": "^8.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/bun": "^1.4.3",
		"@types/node": "^24.19.2",
		"@types/qrcode": "^1.5.6",
		"chalk": "^5.6.2",
		"commander": "^15.0.0",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^3.5.2",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"ulid": "^3.0.2",
		"vite": "^8.3.4",
		"wrangler": "^4.151.1"
	},
	"dependencies": {
		"qrcode": "^1.5.4"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
